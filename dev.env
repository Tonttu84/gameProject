# Campaign-server dev settings: the names only, never a value. The values live
# in the private secrets repo as gameproject/dev.env, an overlay that wins over
# this file (${SECRETS_DIR:-../secrets}/gameproject/dev.env). docker compose
# loads both; make serve / server-node load the overlay through
# scripts/with-dev-env.sh. Without the overlay the server still starts: a random
# per-process JWT secret and no dev login, each with a boot warning
# (docs/decisions.md D10).
SECRET=
DEV_USER=
DEV_PASSWORD=
