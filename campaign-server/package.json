{
  "name": "campaign-server",
  "version": "0.1.0",
  "description": "Campaign BFF: serves the unit catalog and maps, runs battles via the C++ engine, stores per-tick replays in MongoDB",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "npm": ">=11"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance-sheet": "node scripts/balanceSheet.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^10.2.3",
    "mongoose": "^8.16.0"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
