{
  "name": "campaign-server",
  "version": "0.1.0",
  "description": "Campaign BFF: serves the unit catalog and maps, runs battles via the C++ engine, stores per-tick replays in MongoDB",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "npm": ">=11"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24"
    }
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance-sheet": "node scripts/balanceSheet.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^4.1.12"
  }
}
