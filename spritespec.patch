+{
+  "_comment": [
+    "CONTRACT between claude.design (art) and the C++/SFML engine. Ship the real file as",
+    "assets/sprites/manifest.json with the same shape. Filenames + pixel sizes here MUST match",
+    "the delivered PNGs exactly — the engine reads this and wires up sf::Texture/sf::Sprite with",
+    "zero guessing. See ART_BRIEF.md for what each sprite depicts and ../../docs/RENDERING_PLAN.md",
+    "for how it's consumed. Field reference is in the '_fields' block below.",
+    "This example enumerates the full planned roster; drop 'planned:true' entries you defer."
+  ],
+
+  "_fields": {
+    "version": "manifest schema version (int).",
+    "projection": "iso tile geometry the engine uses to place tiles/skirts. tileW/tileH = top-face box in px; elevationStep = px height of one elevation level (one skirt tile).",
+    "defaults": "fps fallback for animations; teamColor is the chosen strategy: 'mask' | 'variants' | 'tint' (see ART_BRIEF §0).",
+    "sprites.<key>.kind": "'unit' | 'tile' | 'skirt' | 'overlay' | 'projectile' | 'fx' | 'prop' | 'decal'.",
+    "sprites.<key>.sheet": "spritesheet PNG (units/props with animation rows). Use 'file' instead for single-image sprites (tiles/fx/projectiles).",
+    "sprites.<key>.mask": "grayscale team-tint mask sheet, same dims as sheet (only when teamColor='mask'). white=recolor, black=keep.",
+    "sprites.<key>.frameW/frameH": "one animation frame's px size (sheets).",
+    "sprites.<key>.w/h": "image px size (single-image sprites).",
+    "sprites.<key>.anchor": "[x,y] px pinned to the target point: unit/prop feet -> hex center; tile -> hex center; edge prop -> edge midpoint.",
+    "sprites.<key>.size": "engine AUnit SIZE this maps to (sanity/scale reference only).",
+    "sprites.<key>.variants": "number of interchangeable variant images (suffix _0.._N-1) for anti-repetition; omit or 1 = single.",
